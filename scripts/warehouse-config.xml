<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Main Warehouse -->
        <record id="main_warehouse" model="stock.warehouse">
            <field name="name">Main Warehouse</field>
            <field name="code">WH-MAIN</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Purchase Warehouse -->
        <record id="purchase_warehouse" model="stock.warehouse">
            <field name="name">Purchase Warehouse</field>
            <field name="code">WH-PURCH</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Sales Warehouse -->
        <record id="sales_warehouse" model="stock.warehouse">
            <field name="name">Sales Warehouse</field>
            <field name="code">WH-SALES</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Locations -->
        <record id="location_main" model="stock.location">
            <field name="name">Main Location</field>
            <field name="complete_name">WH-MAIN/Stock</field>
            <field name="usage">internal</field>
            <field name="warehouse_id" ref="main_warehouse"/>
        </record>

        <record id="location_purchase" model="stock.location">
            <field name="name">Purchase Location</field>
            <field name="complete_name">WH-PURCH/Stock</field>
            <field name="usage">internal</field>
            <field name="warehouse_id" ref="purchase_warehouse"/>
        </record>

        <record id="location_sales" model="stock.location">
            <field name="name">Sales Location</field>
            <field name="complete_name">WH-SALES/Stock</field>
            <field name="usage">internal</field>
            <field name="warehouse_id" ref="sales_warehouse"/>
        </record>

        <!-- Operation Types -->
        <record id="operation_receive" model="stock.picking.type">
            <field name="name">Receive Products</field>
            <field name="code">incoming</field>
            <field name="warehouse_id" ref="main_warehouse"/>
        </record>

        <record id="operation_deliver" model="stock.picking.type">
            <field name="name">Deliver Products</field>
            <field name="code">outgoing</field>
            <field name="warehouse_id" ref="main_warehouse"/>
        </record>

        <record id="operation_internal" model="stock.picking.type">
            <field name="name">Internal Transfers</field>
            <field name="code">internal</field>
            <field name="warehouse_id" ref="main_warehouse"/>
        </record>
    </data>
</odoo>
