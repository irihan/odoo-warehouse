<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- مسؤول المخازن -->
        <record id="warehouse_manager" model="res.users">
            <field name="name">مسؤول المخازن</field>
            <field name="login">warehouse_manager</field>
            <field name="email">warehouse@example.com</field>
            <field name="password">warehouse123</field>
            <field name="groups_id" eval="[(6, 0, [ref('stock.group_stock_manager')])]"/>
        </record>

        <!-- مسؤول المشتريات -->
        <record id="purchase_officer" model="res.users">
            <field name="name">مسؤول المشتريات</field>
            <field name="login">purchase_officer</field>
            <field name="email">purchase@example.com</field>
            <field name="password">purchase123</field>
            <field name="groups_id" eval="[(6, 0, [ref('purchase.group_purchase_manager')])]"/>
        </record>

        <!-- مسؤول المبيعات -->
        <record id="sales_officer" model="res.users">
            <field name="name">مسؤول المبيعات</field>
            <field name="login">sales_officer</field>
            <field name="email">sales@example.com</field>
            <field name="password">sales123</field>
            <field name="groups_id" eval="[(6, 0, [ref('sales_team.group_sale_manager')])]"/>
        </record>

        <!-- المحاسب -->
        <record id="accountant" model="res.users">
            <field name="name">المحاسب</field>
            <field name="login">accountant</field>
            <field name="email">account@example.com</field>
            <field name="password">account123</field>
            <field name="groups_id" eval="[(6, 0, [ref('account.group_account_manager')])]"/>
        </record>

        <!-- المندوب الميداني -->
        <record id="field_representative" model="res.users">
            <field name="name">المندوب الميداني</field>
            <field name="login">field_rep</field>
            <field name="email">field@example.com</field>
            <field name="password">field123</field>
            <field name="groups_id" eval="[(6, 0, [ref('stock.group_stock_user')])]"/>
        </record>
    </data>
</odoo>
